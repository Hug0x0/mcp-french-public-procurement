{
  "name": "mcp-french-public-procurement",
  "version": "0.1.0",
  "description": "MCP server for French public procurement data: DECP, BOAMP discovery, buyers, suppliers, and SIRENE context.",
  "type": "module",
  "bin": {
    "mcp-french-public-procurement": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "postbuild": "chmod +x dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:smoke": "node scripts/smoke-test.mjs",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "open-data",
    "france",
    "procurement",
    "boamp",
    "decp",
    "sirene",
    "marches-publics"
  ],
  "author": "Hug0x0",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hug0x0/mcp-french-public-procurement.git"
  },
  "bugs": {
    "url": "https://github.com/Hug0x0/mcp-french-public-procurement/issues"
  },
  "homepage": "https://github.com/Hug0x0/mcp-french-public-procurement#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.20.4",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
